{
  "name": "unhook-linkedin",
  "description": "Hide your LinkedIn feed and get your work done without distraction. Fully private, no tracking.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "icons": "node scripts/gen-icons.mjs",
    "compile": "tsc --noEmit",
    "check": "pnpm compile && pnpm build && pnpm build:firefox",
    "postinstall": "wxt prepare",
    "reinstall": "bash scripts/install-nosync.sh",
    "security:audit": "pnpm --ignore-pnpmfile audit --audit-level low"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@wxt-dev/module-react": "^1.2.2",
    "potrace": "^2.1.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wxt": "^0.21.5"
  },
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": ">=11.5.1 <12"
  }
}
